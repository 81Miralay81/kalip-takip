<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <appSettings>
    <!-- Veritabanı dosyası. Boş bırakılırsa bu exe ile aynı klasördeki KalipTakip.db kullanılır.
         Masaüstü programla AYNI dosya olmalıdır (ör. D:\KalipTakip\KalipTakip.db ya da \\sunucu\paylasim\KalipTakip.db). -->
    <add key="VeritabaniYolu" value="\\KALIPNAS2019\kaliphanenas\OMUR\takip\KalipTakip.App\bin\Release\net48\KalipTakip.db" />
    <!-- Telefonların bağlanacağı port. -->
    <add key="Port" value="8080" />
    <!-- Güvenli (https) port: telefon kamerası için gerekir. 0 yazılırsa https kapalı olur. Sertifika ilk açılışta otomatik üretilir, yönetici hakkı gerekmez. -->
    <add key="HttpsPort" value="8443" />
    <!-- Kameradan yazı okuma (dövme kalıp kodları) için yapay zeka. Anahtar yazılmazsa özellik kapalıdır.
         GEMINI (ücretsiz katman): https://aistudio.google.com/apikey adresinden anahtar alıp aşağıya yazın.
         Sunucu bilgisayarının generativelanguage.googleapis.com adresine internet erişimi olmalıdır. -->
    <add key="GeminiAnahtar" value="AQ.Ab8RN6JY0nyxRwOYAaqj_48GRfz8HDlyTCe9p8Vp4N77xWwK4g" />
    <add key="GeminiModel" value="gemini-3.8-flash" />
    <!-- Düşünme düzeyi: minimal / low / medium / high. Düşük olması okumayı hızlandırır. Hata verirse boş bırakın. -->
    <add key="GeminiYedekModel" value="gemini-flash-lite-latest" />
    <add key="GeminiDusunme" value="low" />
    <!-- İsteğe bağlı: Claude API (ücretli, ayrı fatura). Her iki anahtar da doluysa Gemini kullanılır; Claude için YZSaglayici = claude yazın. -->
    <add key="AnthropicAnahtar" value="" />
    <add key="AnthropicModel" value="claude-haiku-5-5" />
    <add key="YZSaglayici" value="" />
  </appSettings>
</configuration>
