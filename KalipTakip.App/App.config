<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <appSettings>
    <!-- Veritabanı dosyası. Boş bırakılırsa exe ile aynı klasörde KalipTakip.db kullanılır.
         Başka bir yer için tam yol yazın, ör: \\sunucu\paylasim\KalipTakip.db -->
    <add key="VeritabaniYolu" value="" />
    <!-- true yapılırsa giriş ekranında şifresiz, salt-okunur "Misafir" girişi görünür. -->
    <add key="MisafirGirisi" value="false" />
  </appSettings>
</configuration>
