<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>KalipTakip.Arayuz</RootNamespace>
    <AssemblyName>KalipTakip</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\uygulama.ico</ApplicationIcon>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Product>Kalıp Takip Sistemi</Product>
    <Version>2.0.0</Version>
    <!-- SQLite yerel sürücüsü (SQLite.Interop.dll) hem x86 hem x64 için kopyalanır; Any CPU çalışır. -->
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>

  <ItemGroup>
    <!-- Guna.UI2 (.NET Framework 4.8 için derlenmiş). Dosya adı derleme adıyla (Guna.UI2) aynı olmalıdır. -->
    <Reference Include="Guna.UI2">
      <HintPath>Libs\Guna.UI2.dll</HintPath>
    </Reference>
    <Reference Include="System.Configuration" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.Windows.Forms.DataVisualization" />
    <PackageReference Include="System.Data.SQLite.Core" Version="1.0.118" />
    <ProjectReference Include="..\KalipTakip.Core\KalipTakip.Core.vbproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\logo.png" LogicalName="logo.png" />
    <EmbeddedResource Include="Resources\uygulama.ico" LogicalName="uygulama.ico" />
    <EmbeddedResource Include="Resources\kanatix.png" LogicalName="kanatix.png" />
  </ItemGroup>

</Project>
